# Flask
FLASK_ENV=production
FLASK_DEBUG=0
JWT_SECRET=change-this-secret-to-a-long-random-string-at-least-32-bytes
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Mail (required for OTP/email verification flows)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_EMAIL=noreply@gamifiedlearning.com
MAIL_FROM_NAME=Gamified Learning Platform
APP_URL=http://localhost:3000

# OTP verification behavior
EMAIL_VERIFICATION_REQUIRED=true
OTP_EXPIRY_MINUTES=5
OTP_RESEND_MAX_ATTEMPTS=3
OTP_RESEND_WINDOW_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFY_LOCK_MINUTES=10

# Database (preferred)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME

# Database (fallback if DATABASE_URL not set)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamified_learning
